#!/usr/bin/env bash
# Host wrapper for the ops commands (C9 §6.3): it stops and starts services itself and runs every
# DB and file step as `mona ops <step>` in a one-shot container of the api image (compose service
# `ops`), so no service needs the Docker socket. Any other subcommand is forwarded unchanged.
#
#   mona demo-snapshot --name <n> [--reference <ISO>] [--findquery <cases.json>]
#   mona demo-snapshot --refresh-textcache --name <n>
#   mona demo-reset [--name demo] [--prefiled] [--anchor today|YYYY-MM-DD] [--yes]
#   mona stage-build [--early N] [--anchor …] [--timeout S] [--attempts N] [--yes]
#                                              (C9 §6.3's whole build order: demo and demo-prefiled)
#   mona backup --name <n> [--to <dir>]        (default ~/DevFiles/mona-hq/demo-data/snapshots)
#   mona restore --name <n> [--from <dir>] [--anchor …] [--yes]
#   mona up | stop | status                    (start, stop, list the stack; on the box it is the prod stack)
#   mona doctor [--privacy] [--json]           (host checks: GPU, published ports, cloud-key names)
#   mona perf [--dry-run] [--batch <dir>] [--order <file>] [--beats <file>] [--cold|--no-cold]
#                                              (report in <data>/perf; VRAM sampled on the host)
#   mona <anything else>                       (e.g. seed load /seed, hermes-memory)
#
# Environment: MONA_COMPOSE (default "docker compose", or the prod overlay once deploy/bin/deploy has
# run here; add -p <project> per stack), MONA_ROOT (the directory holding compose.yaml),
# MONA_SEED_OVERLAY_HOST (identifiers overlay for seed load); for stage-build MONA_CORPUS_DIR,
# MONA_CORPUS_MANIFEST and MONA_SYNTHETIC_DIR (default: the laptop's demo-data layout).
set -euo pipefail

ROOT=${MONA_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}
STATE=${MONA_DEPLOY_STATE:-$ROOT/.deploy}
if [[ -s "$STATE/current" ]]; then
  MONA_COMPOSE=${MONA_COMPOSE:-docker compose -f compose.yaml -f deploy/compose.prod.yaml}
  MONA_TAG=${MONA_TAG:-$(<"$STATE/current")}
  export MONA_TAG
fi
read -r -a COMPOSE <<<"${MONA_COMPOSE:-docker compose}"
cd "$ROOT"

WORKERS=(worker-llm worker-cpu)
HEALTH_TIMEOUT=120

die() { echo "mona: $*" >&2; exit 1; }
compose() { "${COMPOSE[@]}" "$@"; }

OPS_EXTRA=()

ops_run() {
  local extra=("${OPS_EXTRA[@]}")
  if [[ -n "${MONA_SEED_OVERLAY_HOST:-}" ]]; then
    extra+=(-v "$MONA_SEED_OVERLAY_HOST:/seed-private/identifiers.yaml:ro"
            -e MONA_SEED_OVERLAY=/seed-private/identifiers.yaml)
  fi
  compose --profile ops run --rm --no-deps -T "${extra[@]}" ops "$@"
}

ops() { ops_run mona "$@"; }

wait_healthy() {
  local deadline=$((SECONDS + HEALTH_TIMEOUT)) state
  while ((SECONDS < deadline)); do
    state=$(compose ps --format '{{.Service}}={{.Health}}' api hermes 2>/dev/null | sort | tr '\n' ' ')
    [[ "$state" == "api=healthy hermes=healthy " ]] && return 0
    sleep 2
  done
  die "services not healthy after ${HEALTH_TIMEOUT}s: ${state:-none}"
}

start_services() {
  compose start api "${WORKERS[@]}" hermes >/dev/null
  wait_healthy
}

demo_snapshot() {
  local name="" args=() refresh=0 cases=""
  while (($#)); do
    case "$1" in
      --name) name=$2; shift 2 ;;
      --reference) args+=(--reference "$2"); shift 2 ;;
      --findquery) cases=$2; shift 2 ;;
      --refresh-textcache) refresh=1; shift ;;
      *) die "demo-snapshot: unknown option $1" ;;
    esac
  done
  [[ -n "$name" ]] || die "demo-snapshot: --name is required"
  if ((refresh)); then
    ops ops refresh-textcache --name "$name"
    return
  fi
  compose stop -t 120 "${WORKERS[@]}" hermes >/dev/null
  trap 'start_services' EXIT
  if [[ -n "$cases" ]]; then
    ops ops snapshot --name "$name" "${args[@]}" --findquery - <"$cases"
  else
    ops ops snapshot --name "$name" "${args[@]}"
  fi
}

demo_reset() {
  local name=demo anchor=today yes=0 t0=$SECONDS
  while (($#)); do
    case "$1" in
      --name) name=$2; shift 2 ;;
      --prefiled) name=demo-prefiled; shift ;;
      --anchor) anchor=$2; shift 2 ;;
      --yes) yes=1; shift ;;
      *) die "demo-reset: unknown option $1" ;;
    esac
  done
  ops ops verify --name "$name"
  if ((!yes)); then
    read -r -p "Replace the current state with snapshot '$name'? [y/N] " answer
    [[ "$answer" == [yY]* ]] || die "nothing changed"
  fi
  compose stop -t 120 "${WORKERS[@]}" hermes api >/dev/null
  ops ops restore --name "$name" --anchor "$anchor"
  start_services
  ops ops postcheck --name "$name"
  doctor_settled
  echo "demo-reset $name: done in $((SECONDS - t0)) s"
}

# demo-snapshot for the build: the services come back at once, not at the script's exit.
stage_snapshot() {
  local rc=0
  compose stop -t 120 "${WORKERS[@]}" hermes >/dev/null
  ops ops snapshot --name "$@" || rc=$?
  start_services
  return "$rc"
}

stage_build() {
  local yes=0 early=7 anchor=today timeout=1800 attempts=3 n=1 rc t0=$SECONDS
  while (($#)); do
    case "$1" in
      --early) early=$2; shift 2 ;;
      --anchor) anchor=$2; shift 2 ;;
      --timeout) timeout=$2; shift 2 ;;
      --attempts) attempts=$2; shift 2 ;;
      --yes) yes=1; shift ;;
      *) die "stage-build: unknown option $1" ;;
    esac
  done
  local data="$HOME/DevFiles/mona-hq/demo-data"
  local corpus=${MONA_CORPUS_DIR:-$HOME/DevFiles/mona-hq/100 PDF neclasificate}
  local manifest=${MONA_CORPUS_MANIFEST:-$data/corpus/manifest.jsonl}
  local synthetic=${MONA_SYNTHETIC_DIR:-$data/synthetic}
  [[ -n "${MONA_SEED_OVERLAY_HOST:-}" ]] || die "stage-build: set MONA_SEED_OVERLAY_HOST"
  [[ -d "$corpus" && -d "$synthetic" && -f "$manifest" ]] \
    || die "stage-build: corpus, synthetic folder or corpus manifest not found"
  if ((!yes)); then
    read -r -p "Rebuild the stage: the database and the data trees are emptied. Go on? [y/N] " answer
    [[ "$answer" == [yY]* ]] || die "nothing changed"
  fi
  local mounts=(-v "$(readlink -f "$corpus"):/stage/corpus:ro"
                -v "$(readlink -f "$manifest"):/stage/manifest.jsonl:ro"
                -v "$(readlink -f "$synthetic"):/stage/synthetic:ro"
                -v "$ROOT/demo/expectations.yaml:/stage/expectations.yaml:ro")
  echo "== 1/9 clean slate and the pre-seeded tier"
  compose stop -t 120 "${WORKERS[@]}" hermes api >/dev/null
  ops ops stage clean
  ops seed load /seed --tier preseeded
  start_services
  echo "== 2/9 the pre-filed history through intake"
  OPS_EXTRA=("${mounts[@]}")
  ops ops stage intake --group prefiled --settle --timeout "$timeout"
  OPS_EXTRA=()
  echo "== 3/9 stage settings (C9 §6.7, A18)"
  ops ops stage settings --early "$early"
  echo "== 4/9 demo (pre-batch) with its findQuery cases"
  ops ops stage evidence
  stage_snapshot demo --findquery /data/stage-build/findquery.json
  echo "== 5/9 reset to demo"
  demo_reset --name demo --anchor "$anchor" --yes
  echo "== 6/9 the live batch until its debrief is ready"
  while :; do
    rc=0
    OPS_EXTRA=("${mounts[@]}")
    ops ops stage intake --group live --debrief --timeout "$timeout" || rc=$?
    OPS_EXTRA=()
    ((rc == 0)) && break
    # exit 3: the debrief left a candidate out; another live run from demo may not
    ((rc == 3 && n < attempts)) || die "stage-build: no usable debrief after $n attempt(s)"
    n=$((n + 1))
    echo "-- attempt $n: reset to demo and drop the live batch again"
    demo_reset --name demo --anchor "$anchor" --yes
  done
  echo "== 7/9 demo-prefiled"
  stage_snapshot demo-prefiled
  echo "== 8/9 the live run's caches into demo"
  ops ops refresh-textcache --name demo
  echo "== 9/9 reset to demo and check the cached debrief"
  demo_reset --name demo --anchor "$anchor" --yes
  ops ops stage cache-check
  echo "stage-build: done in $((SECONDS - t0)) s"
}

doctor() {
  local privacy=()
  [[ " $* " == *" --privacy "* ]] && privacy=(--privacy)
  MONA_COMPOSE="${COMPOSE[*]}" MONA_ROOT="$ROOT" "$ROOT/deploy/bin/doctor-host" "${privacy[@]}" \
    | ops_run mona doctor --host-lines - "$@"
}

doctor_settled() {
  local tries=5
  until doctor >/dev/null 2>&1; do
    ((--tries)) || { doctor; die "doctor is red after the reset"; }
    sleep 3
  done
  doctor
}

perf() {
  local args=() dry=0 vram="" sampler=""
  OPS_EXTRA+=(--user "${MONA_UID:-1000}:${MONA_GID:-1000}")
  while (($#)); do
    case "$1" in
      --batch) OPS_EXTRA+=(-v "$(readlink -f "$2"):/perf/batch:ro"); args+=(--batch /perf/batch); shift 2 ;;
      --order) OPS_EXTRA+=(-v "$(readlink -f "$2"):/perf/order:ro"); args+=(--order /perf/order); shift 2 ;;
      --beats) OPS_EXTRA+=(-v "$(readlink -f "$2"):/perf/beats:ro"); args+=(--beats /perf/beats); shift 2 ;;
      --dry-run) dry=1; args+=("$1"); shift ;;
      *) args+=("$1"); shift ;;
    esac
  done
  if ((!dry)) && command -v nvidia-smi >/dev/null; then
    vram=$(mktemp -d)
    nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits -lms 1000 >"$vram/vram.csv" &
    sampler=$!
    trap "kill $sampler 2>/dev/null; rm -rf '$vram'" EXIT
    OPS_EXTRA+=(-v "$vram:/perf/vram:ro")
    args+=(--vram-csv /perf/vram/vram.csv)
  fi
  ops_run mona perf "${args[@]}"
}

backup() {
  local name="" to="${HOME}/DevFiles/mona-hq/demo-data/snapshots"
  while (($#)); do
    case "$1" in
      --name) name=$2; shift 2 ;;
      --to) to=$2; shift 2 ;;
      *) die "backup: unknown option $1" ;;
    esac
  done
  [[ -n "$name" ]] || die "backup: --name is required"
  mkdir -p "$to"
  rm -rf "${to:?}/$name.incoming"
  mkdir "$to/$name.incoming"
  ops_run tar -C /data/snapshots -cf - "$name" | tar -C "$to/$name.incoming" -xf -
  (cd "$to/$name.incoming/$name" && sha256sum -c --quiet sha256sums) || die "backup: sha256sums failed"
  rm -rf "${to:?}/$name"
  mv "$to/$name.incoming/$name" "$to/$name"
  rmdir "$to/$name.incoming"
  echo "backup $name: $to/$name, sha256sums verified"
}

restore() {
  local name="" from="${HOME}/DevFiles/mona-hq/demo-data/snapshots" rest=()
  while (($#)); do
    case "$1" in
      --name) name=$2; shift 2 ;;
      --from) from=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [[ -n "$name" && -d "$from/$name" ]] || die "restore: no snapshot $from/$name"
  (cd "$from/$name" && sha256sum -c --quiet sha256sums) || die "restore: sha256sums failed"
  tar -C "$from" -cf - "$name" | ops_run sh -ec "
    rm -rf /data/snapshots/.$name.incoming && mkdir -p /data/snapshots/.$name.incoming
    tar -C /data/snapshots/.$name.incoming -xf -
    rm -rf /data/snapshots/$name && mv /data/snapshots/.$name.incoming/$name /data/snapshots/$name
    rmdir /data/snapshots/.$name.incoming
    chown -R \"\$MONA_UID:\$MONA_GID\" /data/snapshots/$name"
  demo_reset --name "$name" "${rest[@]}"
}

cmd=${1:-}
[[ -n "$cmd" ]] || die "usage: mona demo-snapshot|demo-reset|backup|restore|<mona subcommand> …"
shift
case "$cmd" in
  demo-snapshot) demo_snapshot "$@" ;;
  demo-reset) demo_reset "$@" ;;
  stage-build) stage_build "$@" ;;
  backup) backup "$@" ;;
  restore) restore "$@" ;;
  up) compose up -d --wait ;;
  stop) compose stop ;;
  status) compose ps ;;
  doctor) doctor "$@" ;;
  perf) perf "$@" ;;
  *) ops "$cmd" "$@" ;;
esac
