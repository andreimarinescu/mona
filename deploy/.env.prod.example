# The box's .env for deploy/compose.prod.yaml (gitignored there). Names only: fill in on the box, never commit values.
# No cloud key belongs here: OPENROUTER_API_KEY, OPENAI_API_KEY and the rest of C9 §2.1's list stay unset.

# Secrets: generate each with `openssl rand -hex 32`
POSTGRES_PASSWORD=
MONA_SERVICE_KEY=
HERMES_API_KEY=
# 64 hex chars; read once, when the seed creates the settings row
MONA_IBAN_PEPPER=
# Unlock password; read by `mona seed load` only
MONA_OWNER_PASSWORD=

# Model endpoint on the compose network (llama-swap, deploy/llm/) and the model id it serves
MONA_LLM_BASE_URL=
MONA_LLM_MODEL=

# Exactly what the browser's address bar shows (scheme://host:port, no trailing slash); every browser write is refused otherwise
MONA_PUBLIC_ORIGIN=

# Telegram owner bot (later testing session): leave unset until then
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Host paths and ports
# Where /data lives on the host (default ./data)
MONA_DATA_HOST=
# Caddy's host port (default 8080), bound to MONA_BIND (default 127.0.0.1; leave it)
WEB_PORT=
MONA_BIND=
# Host UID/GID the python containers and Caddy run as, and that own ./data (default 1000)
MONA_UID=
MONA_GID=
# Host UID/GID that owns the Hermes profile volume (default 1000)
HERMES_UID=
HERMES_GID=
# Compose network pinned so the api can trust Caddy's address (defaults 172.29.250.0/24 and .10)
MONA_SUBNET=
MONA_CADDY_IP=

# Tuned from the Oct 8 mona timings (demo-script v2): defaults 35 and fallback
MONA_INTERVIEW_PASS1_BUDGET_S=
MONA_DEBRIEF_CACHE=
