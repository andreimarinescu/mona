# Copy to .env (gitignored) and fill in. Never commit .env.

# Dev inference (R30: dev only; the deployed profile must not use cloud AI)
OPENROUTER_API_KEY=

# Unlock password for the single Mona profile (the /unlock screen); the seed hashes it with argon2
MONA_OWNER_PASSWORD=

# Telegram owner bot, added in a later testing session
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# Dev service secrets: generate each with `openssl rand -hex 32`
# Key the pipeline and Hermes use to call the api's /mcp and service endpoints
MONA_SERVICE_KEY=
# Bearer key of the Hermes API server (our adapter is its only client)
HERMES_API_KEY=
POSTGRES_PASSWORD=
# 32 bytes as 64 hex chars: becomes settings.iban_salt (the IBAN HMAC key) when the seed creates the settings row
MONA_IBAN_PEPPER=
# Private seed identifiers overlay (IBANs, SIRENs, addresses), read by `mona seed load`
# MONA_SEED_OVERLAY=../demo-data/seed/identifiers.yaml

# Optional host ports (defaults shown)
# WEB_PORT=5173
# API_PORT=8765
# POSTGRES_PORT=55432
# HERMES_PORT=8642
# Host UID/GID that owns the Hermes profile volume (defaults 1000)
# HERMES_UID=1000
# HERMES_GID=1000
# Model for Hermes chat and for direct model calls (D9): cheap by default; set qwen/qwen3.6-35b-a3b for quality runs
MONA_CHAT_MODEL=qwen/qwen3.7-flash
MONA_LLM_MODEL=qwen/qwen3.7-flash
# Direct model calls: openrouter (default) or llama-server (prod, C9), with its base URL
# MONA_LLM_BACKEND=openrouter
# MONA_LLM_BASE_URL=http://llama:9292/v1
