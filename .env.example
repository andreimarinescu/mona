# Copy to .env (gitignored) and fill in. Never commit .env.

# Dev inference (R30: dev only; the deployed profile must not use cloud AI)
OPENROUTER_API_KEY=

# Unlock password for the single Mona profile (the /unlock screen); the seed hashes it with argon2
MONA_OWNER_PASSWORD=

# Telegram owner bot, added in a later testing session
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
